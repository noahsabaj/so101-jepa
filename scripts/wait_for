#!/bin/sh
# Wait until FILE exists (scripts/run_lanes.sh): sh scripts/wait_for FILE LANE [AFTER [PID]]
# Fails if lane LANE ends (outputs/lanes/LANE.end) without FILE, or if process PID (the producer, when
# the caller knows it) is gone without FILE. Only a FILE newer than AFTER (default: outputs/lanes/start,
# the start of this lanes run) counts, so a file left by an old run does not.
# The writers publish a file whole: they write FILE.tmp and rename it, so FILE is ready when it exists
# and FILE.tmp does not. (A file that is only the right size is not enough: a killed writer leaves a short one.)
after=${3:-outputs/lanes/start}
[ -e "$after" ] || after=""
ready() {
  [ -e "$1" ] && [ ! -e "$1.tmp" ] && { [ -z "$after" ] || [ "$1" -nt "$after" ]; }
}
until ready "$1"; do
  if [ -e "outputs/lanes/$2.end" ]; then
    sleep 2  # the rename may have come just before the lane's end
    ready "$1" && exit 0
    echo "wait_for: lane $2 ended without $1" >&2
    exit 1
  fi
  if [ -n "$4" ] && ! kill -0 "$4" 2> /dev/null; then
    sleep 2
    ready "$1" && exit 0
    echo "wait_for: process $4 ended without $1" >&2
    exit 1
  fi
  sleep 20
done
